{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run",
        "type": "shell",
        "command": "g++ -std=c++17 -O2 -Wall '${file}' -o /tmp/cp_out && /tmp/cp_out",
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": "$gcc"
      },
      {
        "label": "CSES: run current file (input.txt next to it)",
        "type": "shell",
        "command": "${workspaceFolder}/run.sh",
        "args": ["${file}"],
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "always", "panel": "shared", "clear": true },
        "problemMatcher": "$gcc"
      },
      {
        "label": "Run with input.txt",
        "type": "shell",
        "command": "g++ -std=c++17 -O2 -Wall '${file}' -o /tmp/cp_out && /tmp/cp_out < '${workspaceFolder}/input.txt'",
        "group": "build",
        "presentation": {
          "reveal": "silent",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": "$gcc"
      },
      {
        "label": "Run with input -> output",
        "type": "shell",
        "command": "g++ -std=c++17 -O2 -Wall '${file}' -o /tmp/cp_out && /tmp/cp_out < '${workspaceFolder}/input.txt' > '${workspaceFolder}/output.txt' ",
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "shared",
          "clear": true
        },
        "problemMatcher": "$gcc"
      },
      {
        "type": "cppbuild",
        "label": "C/C++: g++-15 build active file",
        "command": "/opt/homebrew/bin/g++-15",
        "args": [
          "-fdiagnostics-color=always",
          "-g",
          "${file}",
          "-o",
          "${fileDirname}/${fileBasenameNoExtension}"
        ],
        "options": {
          "cwd": "${fileDirname}"
        },
        "problemMatcher": [
          "$gcc"
        ],
        "group": "build",
        "detail": "Task generated by Debugger."
      },
      {
        "type": "cmake",
        "label": "CMake: clean",
        "command": "clean",
        "problemMatcher": [],
        "detail": "CMake template clean task",
        "group": {
          "kind": "build",
          "isDefault": true
        }
      }
    ]
}